{
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },
  "special": {
    "external_directory": "allow"
  },
  "tools": {
    "read": "allow",
    "find": "allow",
    "grep": "allow",
    "ls": "allow"
  },
  "bash": {
    "git status": "allow",
    "git log": "allow",
    "git diff": "allow",
    "git show": "allow",
    "*git commit*": "deny",
    "*git push*": "deny",
    "*git rebase*": "ask",
    "*git reset*": "ask",
    "*git merge*": "ask",
    "*git cherry-pick*": "ask",
    "*git revert*": "ask",
    "*git -c*push*": "ask",
    "*git -c*commit*": "ask",
    "*git -C*push*": "ask",
    "*git -C*commit*": "ask",
    "*gh *": "ask",
    "*ka*": "ask",
    "*kc*": "ask",
    "*kubectl apply*": "ask",
    "*kubectl create*": "ask"
  }
}
